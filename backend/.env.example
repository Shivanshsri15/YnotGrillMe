NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Optional absolute/relative path to knowledge root (defaults to ./knowledge)
KNOWLEDGE_ROOT=

# Comma-separated Gemini API keys (round-robin + failover on 429/5xx)
# Required for POST /api/v1/agent/chat streaming
GEMINI_API_KEYS=your_key_1,your_key_2
# Flash-Lite = fastest interactive chat. Use gemini-3.8-flash + THINKING_LEVEL=low for deeper answers.
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal (Flash-Lite default) | low | medium | high — higher = much slower TTFT
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=768
# Per-attempt timeout (SDK aborts hung fetches). Flaky keys cool down and rotate.
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2
GEMINI_KEY_COOLDOWN_MS=15000

# Global rate limit (per IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Chat endpoint uses a stricter built-in throttle: 20 requests / 60s
# (see AGENT_CHAT_THROTTLE_* in src/agent/constants/agent.constants.ts)

# Contact form persistence (empty disables disk writes; in-memory still accepts messages)
# CONTACT_MESSAGE_DIR=tmp/contact-messages

# GitHub README sync (webhook signature + optional token for rate limits)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
